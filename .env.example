# Meta Model API key (https://dev.meta.ai/docs/authentication)
MODEL_API_KEY=

# Switch agent bridge base URL. Check it with `npm run probe` (GET /health must answer 200).
# For a server Switch Console runs locally this is usually http://localhost:8000
SWITCH_BRIDGE_URL=http://localhost:8000

# A registration API key, created in the Switch Gateway under "API Keys" (type: registration).
# Only needed once, for `npm run register`.
SWITCH_REGISTRATION_KEY=

# Optional model overrides
# MODEL_SUSPECT=muse-spark-1.3
# MODEL_GHOST=muse-spark-1.3
# MODEL_CLERK=muse-spark-1.3
# Cheaper while testing: muse-spark-1.3-contributor (Meta may train on your prompts)

# Act timing in minutes (set lower for demos)
# ACT_MINUTES=10
# CARRIAGE_MINUTES=8
